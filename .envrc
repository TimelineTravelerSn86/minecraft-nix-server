use flake

# Auto-activate the shared Beet venv (see flake.nix) once it exists -
# harmless no-op before you've run the one-time
# `python3 -m venv datapacks-src/.venv` setup. Sourced after `use flake`
# so its bin dir takes priority on PATH over the bare python3 the Nix
# shell provides.
if [ -f datapacks-src/.venv/bin/activate ]; then
  source datapacks-src/.venv/bin/activate
fi