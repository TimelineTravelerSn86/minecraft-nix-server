# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Nix build output symlinks (created by `nix build`)
result
result-*
 
# direnv's local cache - .envrc itself IS tracked, this cache dir isn't
.direnv/
 
# Maven build output - matches plugins-src/*/target/ and any future
# plugin subproject's target/ too, no matter how deep

target/*
target/
!target/*.jar

# Python venv for authoring datapacks with Beet (see flake.nix) - just
# an interpreter + pip install, never commit it. datapacks-src/*/build/
# below is the only datapack output that IS committed.
datapacks-src/.venv

# NOTE: datapacks-src/*/build/ is NOT ignored here, on purpose - unlike
# a typical Beet project, that build output is the committed artifact
# datapacks/sources.nix's mkLocalDatapack packages (same role
# target/*.jar plays for plugins above).

# Editor/OS cruft
.DS_Store
*.swp
 
